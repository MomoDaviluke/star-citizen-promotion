# ===========================================
# 后端服务配置
# ===========================================
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# ===========================================
# JWT 配置
# ===========================================
# ⚠️ 必填：所有环境（除 test 外）必须设置至少 32 字符的强密钥
# ⚠️ 禁止使用默认值或弱密钥，否则应用将处于不安全状态
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ===========================================
# MySQL 数据库配置
# ===========================================
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_NAME=star_citizen_promotion
DB_CONNECTION_LIMIT=20

# ===========================================
# Bcrypt 配置
# ===========================================
BCRYPT_SALT_ROUNDS=12

# ===========================================
# 速率限制
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================================
# CORS 配置
# ===========================================
# 允许的来源域名，多个用逗号分隔
ALLOWED_ORIGINS=https://your-domain.com

# ===========================================
# WebSocket 配置
# ===========================================
WS_PORT=3001

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_FILE_ERROR=logs/error.log
LOG_FILE_COMBINED=logs/combined.log

# ===========================================
# 静态文件路径 (Docker 环境使用)
# ===========================================
# STATIC_FILES_PATH=/app/dist

# ===========================================
# Snyk 安全扫描 (CI 使用)
# ===========================================
# SNYK_TOKEN=your-snyk-token

# ============================================
# AI 集成配置
# ============================================
# LLM Providers (至少配置一个,deepseek 第一期可选)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 模型配置
LLM_CHAT_MODEL=doubao-pro-32k-241215
LLM_CHAT_STREAM_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=doubao-embedding-text-240715
EMBEDDING_DIM=1024
# RAG
PGVECTOR_URL=postgres://app_user:password@localhost:5432/star_citizen_ai
REDIS_URL=redis://localhost:6379
LLM_CACHE_TTL=86400
LLM_REQUEST_TIMEOUT_MS=30000

# ============================================
# 监控告警通知配置
# ============================================
# 配置后告警事件（新开/恢复/升级）推送到外部 webhook；留空则不发送通知
MONITOR_WEBHOOK_URL=
# 消息格式：wecom（企业微信群机器人）/ dingtalk（钉钉机器人）/ feishu（飞书机器人）/ generic（通用 JSON，默认）
MONITOR_WEBHOOK_FORMAT=generic
