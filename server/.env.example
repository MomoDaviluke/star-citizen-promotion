# ===========================================
# 后端服务配置
# ===========================================
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# ===========================================
# JWT 配置
# ===========================================
# ⚠️ 必填：所有环境（除 test 外）必须设置至少 32 字符的强密钥
# ⚠️ 禁止使用默认值或弱密钥，否则应用将处于不安全状态
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ===========================================
# MySQL 数据库配置
# ===========================================
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_NAME=star_citizen_promotion
DB_CONNECTION_LIMIT=20

# ===========================================
# Bcrypt 配置
# ===========================================
BCRYPT_SALT_ROUNDS=12

# ===========================================
# 速率限制
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================================
# CORS 配置
# ===========================================
# 允许的来源域名，多个用逗号分隔
ALLOWED_ORIGINS=https://your-domain.com

# ===========================================
# WebSocket 配置
# ===========================================
WS_PORT=3001

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_FILE_ERROR=logs/error.log
LOG_FILE_COMBINED=logs/combined.log

# ===========================================
# 静态文件路径 (Docker 环境使用)
# ===========================================
# STATIC_FILES_PATH=/app/dist

# ===========================================
# Snyk 安全扫描 (CI 使用)
# ===========================================
# SNYK_TOKEN=your-snyk-token

# ============================================
# AI 集成配置（AI-SLOT 槽位制，可选）
# ============================================
# 聊天槽位：OpenAI 兼容端点自由指向（DeepSeek / 豆包 / vLLM / 任意兼容网关）
# 不配置时服务正常启动，AI 端点自动降级（"AI 服务暂时不可用"属预期行为）
LLM_CHAT_API_KEY=
LLM_CHAT_BASE_URL=https://api.deepseek.com/v1
LLM_CHAT_MODEL=deepseek-chat
LLM_CHAT_STREAM_MODEL=deepseek-chat
# 嵌入槽位：本地 Ollama（bge-m3，1024 维，零 API 成本）或其他 embeddings 服务
# 注意：DeepSeek 官方 API 无 embeddings 接口，嵌入请走 Ollama 或其他向量服务
LLM_EMBED_API_KEY=ollama
LLM_EMBED_BASE_URL=http://localhost:11434/v1
LLM_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# 可选降级槽位（不配置则降级链自动跳过）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
# Anthropic 原生协议（可选，仅聊天降级用）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# RAG 知识库（pgvector，维度须与 EMBEDDING_DIM 一致）
PGVECTOR_URL=postgres://app_user:app_password@localhost:5432/star_citizen_ai
REDIS_URL=redis://localhost:6379
LLM_CACHE_TTL=86400
LLM_REQUEST_TIMEOUT_MS=30000

# ============================================
# 监控告警通知配置
# ============================================
# 配置后告警事件（新开/恢复/升级）推送到外部 webhook；留空则不发送通知
MONITOR_WEBHOOK_URL=
# 消息格式：wecom（企业微信群机器人）/ dingtalk（钉钉机器人）/ feishu（飞书机器人）/ generic（通用 JSON，默认）
MONITOR_WEBHOOK_FORMAT=generic
