# ===========================================
# 后端服务配置
# ===========================================
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-domain.com

# ===========================================
# CORS 配置
# ===========================================
# 生产环境必须设置，支持多个域名逗号分隔
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===========================================
# JWT 配置
# ===========================================
# ⚠️ 必填：生产环境必须设置强密钥（至少 32 字符）
# ⚠️ 禁止使用默认值或弱密钥，否则服务器启动将失败
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ===========================================
# MySQL 数据库配置
# ===========================================
DB_HOST=your-mysql-host
DB_PORT=3306
# ⚠️ 必填：生产环境必须设置
DB_USER=your_db_user
# ⚠️ 必填：生产环境必须设置强密码
DB_PASSWORD=
DB_NAME=star_citizen_promotion
DB_CONNECTION_LIMIT=20

# ===========================================
# Bcrypt 配置
# ===========================================
BCRYPT_SALT_ROUNDS=12

# ===========================================
# 速率限制
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===========================================
# WebSocket 配置
# ===========================================
WS_PORT=3003

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_ERROR=logs/error.log
LOG_FILE_COMBINED=logs/combined.log
