# ============================================
# 真实集成测试 环境示例（可选覆盖，均有安全默认值）
# 复制为 .env.test 可按需覆盖默认；不建也能一键跑（用 compose 内默认值）
# ============================================

# JWT_SECRET —— 必备！config 生产模式 FATAL 校验：长度必须 >= 32 字符，
#               否则后端启动即抛 "JWT_SECRET must be at least 32 characters"
TEST_JWT_SECRET=IntegrationTestJwtSecret32CharMin

# DB 密码/库名 —— 建议用「无特殊字符」值，避免 ! 等字符在 shell/CLI 转义
#               导致 mysql_native_password 认证失败（Access denied）的坑
TEST_DB_PASSWORD=TestPass123456
TEST_DB_NAME=star_citizen_test

# 端口隔离（避免与本机开发服务冲突）
TEST_MYSQL_PORT=13306     # 容器 3306 → 宿主 13306
TEST_BACKEND_PORT=3101    # 容器 3101 → 宿主 3101（connectivity-smoke 默认指向此端口）