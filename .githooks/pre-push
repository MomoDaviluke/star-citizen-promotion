#!/usr/bin/env bash
# ============================================================
# pre-push 安全 / 测试钩子
# 推送前运行后端测试 + npm audit
# ============================================================
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FAILED=0

echo -e "${YELLOW}[pre-push] 推送前检查...${NC}"

# ── 1. 后端测试 ──────────────────────────────────────────
if [ -d "$ROOT_DIR/server" ]; then
  echo -e "${YELLOW}[pre-push] 运行后端测试...${NC}"
  cd "$ROOT_DIR/server"
  if node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --cacheDirectory=.jest-cache --passWithNoTests 2>&1 | tail -5; then
    echo -e "${GREEN}  ✓ 后端测试通过${NC}"
  else
    echo -e "${RED}  ✗ 后端测试失败${NC}"
    FAILED=1
  fi
  cd "$ROOT_DIR"
else
  echo -e "${GREEN}[pre-push] 无后端目录，跳过${NC}"
fi

# ── 2. npm audit ─────────────────────────────────────────
echo -e "${YELLOW}[pre-push] npm audit...${NC}"
if npm audit --audit-level=high 2>&1 | tail -1; then
  echo -e "${GREEN}  ✓ 无高危漏洞${NC}"
else
  echo -e "${RED}  ✗ 检测到高危漏洞${NC}"
  FAILED=1
fi

if [ -d "$ROOT_DIR/server" ]; then
  cd "$ROOT_DIR/server"
  echo -e "${YELLOW}[pre-push] 后端 npm audit...${NC}"
  if npm audit --audit-level=high 2>&1 | tail -1; then
    echo -e "${GREEN}  ✓ 后端无高危漏洞${NC}"
  else
    echo -e "${RED}  ✗ 后端检测到高危漏洞${NC}"
    FAILED=1
  fi
  cd "$ROOT_DIR"
fi

if [ "$FAILED" -eq 1 ]; then
  echo -e "${RED}[pre-push] ✗ 检查未通过，推送已中断${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-push] ✓ 全部通过，正在推送...${NC}"
