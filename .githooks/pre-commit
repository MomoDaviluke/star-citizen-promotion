#!/usr/bin/env bash
# ============================================================
# pre-commit 安全钩子
# 在提交前检查暂存文件的代码规范与安全风险
# ============================================================
set -euo pipefail

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FAILED=0

echo -e "${YELLOW}[pre-commit] 开始检查...${NC}"

# ── 1. ESLint ────────────────────────────────────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|vue)$' | grep -v 'node_modules/' | grep -v '\.worktrees/' || true)

if [ -n "$STAGED_JS" ]; then
  echo -e "${YELLOW}[pre-commit] ESLint 检查暂存文件...${NC}"
  echo "$STAGED_JS" | while read -r file; do
    npx eslint --quiet "$ROOT_DIR/$file" 2>/dev/null || {
      echo -e "${RED}  ✗ $file${NC}"
      FAILED=1
    }
  done
else
  echo -e "${GREEN}[pre-commit] 无 JS/Vue 文件变更，跳过 ESLint${NC}"
fi

# ── 2. 敏感信息检测 ──────────────────────────────────────
echo -e "${YELLOW}[pre-commit] 敏感信息检测...${NC}"
SECRET_PATTERNS=(
  'AKIA[0-9A-Z]{16}'                        # AWS Access Key
  'ghp_[0-9a-zA-Z]{36}'                     # GitHub Personal Access Token
  'sk-[0-9a-zA-Z]{32,}'                     # OpenAI API Key
  '-----BEGIN\s+(RSA|DSA|EC|OPENSSH)\s+PRIVATE KEY-----'  # Private Key
  'password\s*=\s*[\x27\x22][^\x27\x22]{6,}'  # Hardcoded password
)

if [ -n "$STAGED_JS" ]; then
  echo "$STAGED_JS" | while read -r file; do
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if git diff --cached "$file" | grep -qiE "$pattern"; then
        echo -e "${RED}  ✗ 检测到疑似敏感信息: $file${NC}"
        echo "    模式: $pattern"
        FAILED=1
      fi
    done
  done
else
  echo -e "${GREEN}[pre-commit] 无文件变更，跳过敏感信息检测${NC}"
fi

# ── 3. .env 文件检测 ─────────────────────────────────────
STAGED_ENV=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.env$|\.env\.(?!example)' || true)
if [ -n "$STAGED_ENV" ]; then
  echo -e "${RED}[pre-commit] 禁止提交 .env 文件！${NC}"
  echo "$STAGED_ENV" | while read -r file; do
    echo -e "${RED}  ✗ $file${NC}"
  done
  FAILED=1
fi

# ── 4. 大文件检测 ────────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | while read -r file; do
    if [ -f "$ROOT_DIR/$file" ]; then
      size=$(stat -c%s "$ROOT_DIR/$file" 2>/dev/null || echo 0)
      if [ "$size" -gt 1048576 ]; then  # 1MB
        echo -e "${YELLOW}  ⚠ 大文件 ($(echo "scale=1; $size/1048576" | bc)MB): $file${NC}"
      fi
    fi
  done
fi

# ── 结果 ─────────────────────────────────────────────────
if [ "$FAILED" -eq 1 ]; then
  echo -e "${RED}[pre-commit] ✗ 检查未通过，提交已中断${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-commit] ✓ 检查全部通过${NC}"
