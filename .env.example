# ===========================================
# 应用基础配置
# ===========================================
VITE_APP_ENV=development
VITE_APP_NAME=Star Citizen Promotion

# ===========================================
# 前端服务配置
# ===========================================
VITE_SERVER_PORT=3000
VITE_SERVER_HOST=localhost
VITE_API_PREFIX=/api

# ===========================================
# 后端服务配置
# ===========================================
VITE_BACKEND_PORT=3001
VITE_BACKEND_HOST=localhost
VITE_BACKEND_URL=http://localhost:3001

# ===========================================
# AI 服务配置
# ===========================================
VITE_AI_SERVICE_PORT=3002
VITE_AI_SERVICE_HOST=localhost
VITE_AI_SERVICE_URL=http://localhost:3002

VITE_AI_TIMEOUT=30000
VITE_AI_MAX_RETRIES=3
VITE_AI_MAX_CONCURRENT=3

# ===========================================
# WebSocket 配置
# ===========================================
VITE_WS_PORT=3001
VITE_WS_HOST=localhost
VITE_WS_URL=ws://localhost:3001/ws

# ===========================================
# 第三方服务配置 (生产环境请填入真实值)
# ===========================================
# VITE_OPENAI_API_KEY=your_openai_api_key
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key

# ===========================================
# Sentry 错误监控 (可选)
# ===========================================
# VITE_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ===========================================
# 功能开关
# ===========================================
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_DEBUG_PANEL=false

# ===========================================
# PostgreSQL
# ===========================================
PG_PASSWORD=ChangeMeInProduction
